@model AP.Data.Product

@{
    ViewBag.Title = "Crear producto";
}

<main>
    <div class="page-header">
        <h1>Crear producto</h1>
        <p class="lead text-muted">Agregar un nuevo producto al catálogo</p>
    </div>

@using (Html.BeginForm()) 
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

    <div class="detail-card mb-4">
        <div class="product-detail-modal-card">
            <div class="product-detail-title">Nuevo producto</div>
            <table class="table product-detail-table product-edit-table">
                <tbody>
                    <tr>
                        <th>Nombre del producto</th>
                        <td>
                            @Html.EditorFor(model => model.ProductName, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger" })
                        </td>
                    </tr>
                    <tr>
                        <th>Inventario</th>
                        <td>
                            @Html.EditorFor(model => model.InventoryID, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.InventoryID, "", new { @class = "text-danger" })
                        </td>
                    </tr>
                    <tr>
                        <th>Proveedor</th>
                        <td>
                            @Html.EditorFor(model => model.SupplierID, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.SupplierID, "", new { @class = "text-danger" })
                        </td>
                    </tr>
                    <tr>
                        <th>Descripción</th>
                        <td>
                            @Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                        </td>
                    </tr>
                    <tr>
                        <th>Valoración</th>
                        <td>
                            @Html.EditorFor(model => model.Rating, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Rating, "", new { @class = "text-danger" })
                        </td>
                    </tr>
                    <tr>
                        <th>Categoría</th>
                        <td>
                            @Html.EditorFor(model => model.CategoryID, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.CategoryID, "", new { @class = "text-danger" })
                        </td>
                    </tr>
                    <tr>
                        <th>Última modificación</th>
                        <td>
                            @Html.EditorFor(model => model.LastModified, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.LastModified, "", new { @class = "text-danger" })
                        </td>
                    </tr>
                    <tr>
                        <th>Modificado por</th>
                        <td>
                            @Html.EditorFor(model => model.ModifiedBy, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.ModifiedBy, "", new { @class = "text-danger" })
                        </td>
                    </tr>
                    <tr>
                        <th>Creado por</th>
                        <td>
                            @Html.EditorFor(model => model.CreatedBy, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.CreatedBy, "", new { @class = "text-danger" })
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="form-actions no-color">
        <input type="submit" value="Crear" class="btn btn-primary" />
        @Html.ActionLink("Volver al listado", "Index", null, new { @class = "btn btn-outline-secondary ms-2" })
    </div>
}
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

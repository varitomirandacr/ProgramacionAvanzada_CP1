@model AP.Data.Product

@{
    ViewBag.Title = "Detalles del producto";
}

<main>
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h1 class="mb-1">Detalles del producto</h1>
            <p class="lead text-muted mb-0">@Model.ProductName</p>
        </div>
        <div>
            @Html.ActionLink("Editar", "Edit", new { id = Model.ProductID }, new { @class = "btn btn-primary" })
            @Html.ActionLink("Volver al listado", "Index", null, new { @class = "btn btn-outline-secondary ms-2" })
        </div>
    </div>

    <div class="detail-card">
        <dl class="dl-horizontal">
            <dt>@Html.DisplayNameFor(model => model.ProductName)</dt>
            <dd>@Html.DisplayFor(model => model.ProductName)</dd>

            <dt>@Html.DisplayNameFor(model => model.InventoryID)</dt>
            <dd>@Html.DisplayFor(model => model.InventoryID)</dd>

            <dt>@Html.DisplayNameFor(model => model.SupplierID)</dt>
            <dd>@Html.DisplayFor(model => model.SupplierID)</dd>

            <dt>@Html.DisplayNameFor(model => model.Description)</dt>
            <dd>@Html.DisplayFor(model => model.Description)</dd>

            <dt>@Html.DisplayNameFor(model => model.Rating)</dt>
            <dd>@Html.DisplayFor(model => model.Rating)</dd>

            <dt>@Html.DisplayNameFor(model => model.CategoryID)</dt>
            <dd>@Html.DisplayFor(model => model.CategoryID)</dd>

            <dt>@Html.DisplayNameFor(model => model.LastModified)</dt>
            <dd>@Html.DisplayFor(model => model.LastModified)</dd>

            <dt>@Html.DisplayNameFor(model => model.ModifiedBy)</dt>
            <dd>@Html.DisplayFor(model => model.ModifiedBy)</dd>

            <dt>@Html.DisplayNameFor(model => model.CreatedBy)</dt>
            <dd>@Html.DisplayFor(model => model.CreatedBy)</dd>
        </dl>
    </div>
</main>

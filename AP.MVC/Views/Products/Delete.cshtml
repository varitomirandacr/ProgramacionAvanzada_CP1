@model AP.Data.Product

@{
    ViewBag.Title = "Eliminar producto";
}

<main>
    <div class="page-header">
        <h1>Eliminar producto</h1>
        <p class="lead text-muted">¿Está seguro de que desea eliminar este producto?</p>
    </div>

    <div class="detail-card mb-4">
        <div class="product-detail-modal-card">
            <div class="product-detail-title">@Model.ProductName</div>
            <table class="table table-dark product-detail-table">
                <tbody>
                    <tr>
                        <th>Nombre del producto</th>
                        <td>@Model.ProductName</td>
                    </tr>
                    <tr>
                        <th>Inventario</th>
                        <td>@Model.InventoryID</td>
                    </tr>
                    <tr>
                        <th>Proveedor</th>
                        <td>@Model.SupplierID</td>
                    </tr>
                    <tr>
                        <th>Descripción</th>
                        <td>@Model.Description</td>
                    </tr>
                    <tr>
                        <th>Valoración</th>
                        <td>@Model.Rating</td>
                    </tr>
                    <tr>
                        <th>Categoría</th>
                        <td>@Model.CategoryID</td>
                    </tr>
                    <tr>
                        <th>Última modificación</th>
                        <td>@Model.LastModified</td>
                    </tr>
                    <tr>
                        <th>Modificado por</th>
                        <td>@Model.ModifiedBy</td>
                    </tr>
                    <tr>
                        <th>Creado por</th>
                        <td>@Model.CreatedBy</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-actions no-color">
            <input type="submit" value="Eliminar" class="btn btn-danger" />
            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary ms-2" })
        </div>
    }
</main>

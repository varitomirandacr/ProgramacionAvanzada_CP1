@{
    ViewBag.Title = "Inicio";
}

<main>
    <section class="hero" aria-labelledby="aspnetTitle">
        <h1 id="aspnetTitle">Bienvenido a AP</h1>
        <p class="lead">Plataforma basada en ASP.NET MVC para construir aplicaciones web modernas con separación clara de responsabilidades y control total del marcado.</p>
        <p><a href="https://asp.net" class="btn btn-light btn-lg">Más información &raquo;</a></p>
    </section>

    <div class="row g-4">
        <section class="col-md-4" aria-labelledby="gettingStartedTitle">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title" id="gettingStartedTitle">Primeros pasos</h2>
                    <p class="card-text">
                        ASP.NET MVC ofrece un enfoque basado en patrones para crear sitios dinámicos,
                        con separación de responsabilidades y desarrollo ágil.
                    </p>
                    <a class="btn btn-outline-primary" href="https://go.microsoft.com/fwlink/?LinkId=301865">Más información &raquo;</a>
                </div>
            </div>
        </section>
        <section class="col-md-4" aria-labelledby="librariesTitle">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title" id="librariesTitle">Bibliotecas</h2>
                    <p class="card-text">NuGet facilita agregar, actualizar y eliminar bibliotecas y herramientas en tu proyecto.</p>
                    <a class="btn btn-outline-primary" href="https://go.microsoft.com/fwlink/?LinkId=301866">Más información &raquo;</a>
                </div>
            </div>
        </section>
        <section class="col-md-4" aria-labelledby="hostingTitle">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title" id="hostingTitle">Alojamiento web</h2>
                    <p class="card-text">Encuentra un proveedor de hosting con la combinación adecuada de características y precio.</p>
                    <a class="btn btn-outline-primary" href="https://go.microsoft.com/fwlink/?LinkId=301867">Más información &raquo;</a>
                </div>
            </div>
        </section>
    </div>
</main>

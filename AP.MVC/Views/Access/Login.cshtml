@{
    ViewBag.Title = "Iniciar sesión";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div class="login-card">
    <div class="login-card-header">
        <h1>Iniciar sesión</h1>
        <p class="login-card-sub">Ingrese credenciales (usuario y contraseña pueden ir vacíos)</p>
    </div>
    @using (Html.BeginForm("Login", "Access", FormMethod.Post, new { @class = "login-form" }))
    {
        <div class="form-group">
            <label for="username">Correo electrónico</label>
            <input type="text" id="username" name="username" class="form-control" placeholder="Correo electrónico" autocomplete="username" />
        </div>
        <div class="form-group">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" class="form-control" placeholder="Contraseña" autocomplete="current-password" />
        </div>
        <div class="login-form-meta">
            <label class="remember-check">
                <input type="checkbox" />
                <span>Recordarme</span>
            </label>
            <a href="#" class="forgot-link">¿Olvidó su contraseña?</a>
        </div>
        <button type="submit" class="btn btn-login w-100">Entrar</button>
        <p class="login-register">¿No tiene una cuenta? <a href="#">Regístrese</a></p>
    }
</div>

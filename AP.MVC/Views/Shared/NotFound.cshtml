@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>No encontrado - AP</title>
    <style>
        body { font-family: "Segoe UI", system-ui, sans-serif; background: #f8f9fa; color: #212529; margin: 0; padding: 2rem; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .error-box { text-align: center; max-width: 420px; }
        h1 { font-size: 2rem; margin-bottom: 0.5rem; }
        h2 { font-size: 1rem; font-weight: normal; color: #6c757d; margin-bottom: 1.5rem; }
        a { color: #0d6efd; text-decoration: none; font-weight: 500; }
        a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="error-box">
        <h1>404</h1>
        <h2>El recurso solicitado no existe o no está disponible.</h2>
        <a href="@Url.Action("Index", "Home")">Volver al inicio</a>
    </div>
</body>
</html>

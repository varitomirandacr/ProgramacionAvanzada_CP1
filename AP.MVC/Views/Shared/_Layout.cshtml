<!DOCTYPE html>
<html lang="es">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - SC-601 Programacion Avanzada</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="main-layout">
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark app-nav">
        <div class="container-fluid">
            <button type="button" class="btn btn-link d-md-none me-2 sidebar-toggler text-white text-decoration-none p-2" id="sidebarToggler" title="Menú" aria-label="Abrir menú">
                <span aria-hidden="true">☰ Menú</span>
            </button>
            @Html.ActionLink("SC-601 Programacion Avanzada", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <div class="ms-auto app-nav-actions">
                <a href="#" class="nav-icon-link" aria-label="Configuración" title="Configuración">
                    <span aria-hidden="true">⚙</span>
                </a>
                <a href="#" class="nav-icon-link" aria-label="Perfil" title="Perfil">
                    <span aria-hidden="true">👤</span>
                </a>
                <a href="@Url.Action("Logout", "Access")" class="nav-icon-link nav-icon-link-logout" aria-label="Cerrar sesión" title="Cerrar sesión">
                    <span aria-hidden="true">⎋</span>
                </a>
            </div>
       </div>
    </nav>
    <div class="sidebar-backdrop d-md-none" id="sidebarBackdrop" aria-hidden="true"></div>
    <div class="app-wrapper">
        <aside class="app-sidebar" id="appSidebar">
            <nav class="sidebar-nav">
                <ul>
                    <li>@Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { @class = "sidebar-link" })</li>
                    <li>@Html.ActionLink("Acerca de", "About", "Home", new { area = "" }, new { @class = "sidebar-link" })</li>
                    <li>@Html.ActionLink("Contacto", "Contact", "Home", new { area = "" }, new { @class = "sidebar-link" })</li>
                    <li>@Html.ActionLink("Productos", "Index", "Products", new { area = "" }, new { @class = "sidebar-link" })</li>
                    <li>@Html.ActionLink("Cerrar sesión", "Login", "Access", new { area = "" }, new { @class = "sidebar-link sidebar-link-logout" })</li>
                </ul>
            </nav>
        </aside>
        <div class="app-main">
            <div class="body-content">
                @RenderBody()
            </div>
            <footer class="site-footer">
                <p class="mb-0">&copy; @DateTime.Now.Year AP. Todos los derechos reservados.</p>
            </footer>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script>
        (function () {
            var sidebar = document.getElementById('appSidebar');
            var toggler = document.getElementById('sidebarToggler');
            var backdrop = document.getElementById('sidebarBackdrop');
            if (sidebar && toggler) {
                toggler.addEventListener('click', function () {
                    sidebar.classList.toggle('show');
                    if (backdrop) {
                        backdrop.classList.toggle('show', sidebar.classList.contains('show'));
                        document.body.style.overflow = sidebar.classList.contains('show') ? 'hidden' : '';
                    }
                });
            }
            if (backdrop) {
                backdrop.addEventListener('click', function () {
                    if (sidebar) sidebar.classList.remove('show');
                    backdrop.classList.remove('show');
                    document.body.style.overflow = '';
                });
            }
        })();
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
